# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-5

# Get this from the Clerk dashboard: Configure > API Keys > "Frontend API URL"
# It looks like https://your-app-name.clerk.accounts.dev (no trailing slash)
CLERK_ISSUER=https://your-app-name.clerk.accounts.dev

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# Local Postgres, e.g. via: docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saksham
